{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>neteye-platform/repo-commons"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [".pre-commit-hooks.yaml", ".pre-commit-config.yaml"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>golang-version) depName=(?<depName>go)\\r?\\n[ \\t]*(?:language_version|golang):[ \\t]*[\\\"'](?<currentValue>[\\d.]+)[\\\"']",
        "# renovate: datasource=(?<datasource>go) depName=(?<depName>[a-zA-Z0-9._/-]+)\\r?\\n[ \\t]*-[ \\t]*\\S+@(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Wait 7 days before proposing newly published versions of any dependency",
      "matchPackageNames": ["*"],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchPackageNames": ["go"],
      "matchManagers": ["gomod", "custom.regex"],
      "groupName": "Go toolchain",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Keep the kubeconform library in go.mod in sync with the hook's kubeconform binary",
      "matchPackageNames": ["github.com/yannh/kubeconform"],
      "matchManagers": ["gomod", "custom.regex"],
      "groupName": "kubeconform",
      "minimumReleaseAge": "7 days"
    }
  ]
}
